pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

import qs

// Sampled from /proc
// Exposed properties are read-only - only sample() writes them
Singleton {
  id: root

  // percentages
  property real cpuPerc: 0
  property real memPerc: 0

  // Absolute memory in GiB
  property real memUsedGb: 0
  property real memTotalGb: 0

  // cpu usage exists only as a delta between two samples
  property var prevCpu: null 

  function sample() {
    statFile.reload();
    meminfoFile.reload();

    const stat = statFile.text();
    const meminfo = meminfoFile.text();
    if (!stat || !meminfo)
      return;
      
    // First line: "cpu  user nice system idle iowait irq softirq steal ..."
    const fields = stat.split("\n")[0].split(/\s+/).slice(1).map(Number);
    if (fields.length < 5)
      return;

    const total = fields.reduce((a, b) => a + b, 0);
    // idle and iowait both count as not-busy
    const idle = fields[3] + fields[4];

    if (root.prevCpu) {
      const totalDelta = total - root.prevCpu.total;
      const idleDelta = idle - root.prevCpu.idle;
      if (totalDelta > 0)
        root.cpuPerc = Math.max(0, Math.min(100, (1 - idleDelta / totalDelta) * 100));
    }
    root.prevCpu = {
      total: total,
      idle: idle
    };

    // linux fills spare RAM with reclaimable diskcache, 
    // so MemFree would report that cache as used
    const totalMatch = meminfo.match(/MemTotal:\s+(\d+)/);
    const availMatch = meminfo.match(/MemAvailable:\s+(\d+)/);
    if (!totalMatch || !availMatch)
      return;

    const totalKb = Number(totalMatch[1]);
    const usedKb = totalKb - Number(availMatch[1]);

    root.memTotalGb = totalKb / 1048576; // kb -> GiB
    root.memUsedGb = usedKb / 1048576;
    root.memPerc = totalKb > 0 ? (usedKb / totalKb) * 100 : 0;
  }

  // /proc is generated by the kernel on read, so it never fires inotify events
  // and watchChanges cannot work - the timer has to reload() explicitly.
  // blockLoading makes reload synchronous, which is safe for these tiny files
  // since no disk I/O is involved.
  FileView {
    id: statFile

    path: "/proc/stat"
    blockLoading: true
  }

  FileView {
    id: meminfoFile

    path: "/proc/meminfo"
    blockLoading: true
  }

  Timer {
    interval: Config.metricsInterval
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: root.sample()
  }
}
